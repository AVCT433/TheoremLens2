GEMINI_API_KEY=your-key-here
# 답변 생성 모델 (결제 연결 시 gemini-3.1-pro-preview 등 Pro 모델로 올릴 수 있음; 무료 티어는 Pro 한도 0)
THEOREMLENS_ANSWER_MODEL=gemini-3.8-flash
# 검증·OCR 모델 (속도 우선)
THEOREMLENS_FAST_MODEL=gemini-3.8-flash
# 로컬 임베딩 모델(sentence-transformers). 첫 실행 때 HuggingFace에서 내려받는다. 바꾸면 자동으로 재임베딩된다.
THEOREMLENS_EMBED_MODEL=BAAI/bge-m3
# auto(CUDA가 있으면 cuda, 없으면 cpu) | cpu | cuda
THEOREMLENS_EMBED_DEVICE=auto
THEOREMLENS_EMBED_BATCH=8
THEOREMLENS_EMBED_MAX_SEQ=1024
# e5/nomic 등 접두어가 필요한 모델만 설정 (예: "query: ", "passage: ")
THEOREMLENS_EMBED_QUERY_PREFIX=
THEOREMLENS_EMBED_DOC_PREFIX=
# PDF 추출(MinerU): tier = flash | basic | standard | advanced, ocr mode = auto | txt | ocr
THEOREMLENS_MINERU_TIER=advanced
THEOREMLENS_MINERU_OCR_MODE=auto
THEOREMLENS_MAX_UPLOAD_MB=300
