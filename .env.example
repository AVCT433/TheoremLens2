GEMINI_API_KEY=your-key-here
# 답변 생성 모델 (결제 연결 시 gemini-3.1-pro-preview 등 Pro 모델로 올릴 수 있음; 무료 티어는 Pro 한도 0)
THEOREMLENS_ANSWER_MODEL=gemini-3.8-flash
# 검증·OCR 모델 (속도 우선)
THEOREMLENS_FAST_MODEL=gemini-3.8-flash
THEOREMLENS_EMBED_MODEL=gemini-embedding-001
# 텍스트 PDF 추출 방식: auto(marker 설치 시 marker) | marker | pymupdf | gemini
THEOREMLENS_TEXT_EXTRACTOR=auto
THEOREMLENS_MAX_UPLOAD_MB=300
